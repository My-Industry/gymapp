# Copy to .env.local for local development, and add the same two
# variables in Vercel -> Project -> Settings -> Environment Variables.

# Random string, 32+ characters:  npm run hash-password -- --secret
AUTH_SECRET=

# Comma-separated username:hash pairs. Make each hash with:  npm run hash-password
# Example: AUTH_USERS=owner:scrypt.salt.key,frontdesk:scrypt.salt.key
# (Or just use the Sign up page while running `npm run dev` - it fills this file in for you.)
AUTH_USERS=

# Who can open Settings. Comma-separated usernames. Leave empty and the first
# account in AUTH_USERS is the admin.
AUTH_ADMINS=

# Where members are stored: a private Google Sheet, reached only by the server.
# See README -> "Storing members in Google Sheets". These ARE secrets: never use VITE_ for them.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the "private_key" value from the JSON key file, in double quotes, keeping the \n parts.
GOOGLE_PRIVATE_KEY=
# The spreadsheet's link (or just the long id between /d/ and /edit).
GOOGLE_SHEET_ID=

# Optional extra backup to Google Sheets / OneDrive (Settings tab). Public client ids, not secrets.
# They are baked in at build time, so set them in Vercel BEFORE deploying, and
# restart `npm run dev` after editing .env.local. See README -> "Backup setup".
VITE_GOOGLE_CLIENT_ID=
VITE_MICROSOFT_CLIENT_ID=
